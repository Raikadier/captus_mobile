{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "project": "Captus",
    "version": "1.0.0",
    "platform": "Flutter · Material Design 3",
    "generatedAt": "2025",
    "description": "Single source of truth — Design Tokens for Captus mobile app"
  },

  "color": {
    "$type": "group",

    "primitive": {
      "$description": "Raw palette — never use directly in UI. Use semantic tokens.",
      "brand": {
        "green-300": { "$type": "color", "$value": "#55D983" },
        "green-500": { "$type": "color", "$value": "#1DB954", "$description": "Captus primary brand color" },
        "green-700": { "$type": "color", "$value": "#158A3E" },
        "green-900": { "$type": "color", "$value": "#0D5C29" }
      },
      "neutral": {
        "0":    { "$type": "color", "$value": "#FFFFFF" },
        "50":   { "$type": "color", "$value": "#F5F5F5" },
        "100":  { "$type": "color", "$value": "#EEEEEE" },
        "200":  { "$type": "color", "$value": "#BDBDBD" },
        "300":  { "$type": "color", "$value": "#9E9E9E" },
        "400":  { "$type": "color", "$value": "#757575" },
        "500":  { "$type": "color", "$value": "#616161" },
        "600":  { "$type": "color", "$value": "#3D3D3D" },
        "700":  { "$type": "color", "$value": "#2C2C2C" },
        "800":  { "$type": "color", "$value": "#1E1E1E" },
        "850":  { "$type": "color", "$value": "#171717" },
        "900":  { "$type": "color", "$value": "#121212" },
        "1000": { "$type": "color", "$value": "#000000" }
      },
      "error": {
        "400": { "$type": "color", "$value": "#EF9A9A" },
        "500": { "$type": "color", "$value": "#CF6679" },
        "700": { "$type": "color", "$value": "#B71C1C" }
      },
      "warning": {
        "400": { "$type": "color", "$value": "#FFCC80" },
        "500": { "$type": "color", "$value": "#FF9800" },
        "700": { "$type": "color", "$value": "#E65100" }
      },
      "info": {
        "400": { "$type": "color", "$value": "#81D4FA" },
        "500": { "$type": "color", "$value": "#29B6F6" },
        "700": { "$type": "color", "$value": "#0277BD" }
      },
      "success": {
        "400": { "$type": "color", "$value": "#A5D6A7" },
        "500": { "$type": "color", "$value": "#1DB954" },
        "700": { "$type": "color", "$value": "#1B5E20" }
      },
      "accent": {
        "purple-400": { "$type": "color", "$value": "#CE93D8" },
        "purple-500": { "$type": "color", "$value": "#AB47BC" },
        "amber-400":  { "$type": "color", "$value": "#FFD54F" },
        "amber-500":  { "$type": "color", "$value": "#FFC107" }
      }
    },

    "semantic": {
      "$description": "Semantic tokens with Light and Dark mode values. Always use these in components.",

      "brand": {
        "primary":       { "$type": "color", "light": "#1DB954", "dark": "#1DB954", "$description": "Primary brand color. WCAG note: 3.0:1 on white — valid only for text ≥18sp or bold ≥14sp." },
        "primary-dark":  { "$type": "color", "light": "#158A3E", "dark": "#158A3E" },
        "primary-light": { "$type": "color", "light": "#55D983", "dark": "#55D983" }
      },

      "bg": {
        "default":         { "$type": "color", "light": "#FFFFFF", "dark": "#121212", "$description": "App background" },
        "surface":         { "$type": "color", "light": "#F5F5F5", "dark": "#1E1E1E", "$description": "Cards, sheets, elevated surfaces" },
        "surface-variant": { "$type": "color", "light": "#EEEEEE", "dark": "#2C2C2C", "$description": "Secondary surfaces, input backgrounds" },
        "elevated":        { "$type": "color", "light": "#FFFFFF", "dark": "#2C2C2C", "$description": "Dialogs, dropdowns" },
        "overlay":         { "$type": "color", "light": "#2C2C2C", "dark": "#000000", "$description": "Modal scrim — use with opacity 0.5" }
      },

      "text": {
        "primary":   { "$type": "color", "light": "#121212", "dark": "#FFFFFF",  "$description": "Main readable text — WCAG AAA" },
        "secondary": { "$type": "color", "light": "#616161", "dark": "#9E9E9E",  "$description": "Supporting text — WCAG AA" },
        "disabled":  { "$type": "color", "light": "#BDBDBD", "dark": "#616161",  "$description": "Non-interactive text" },
        "on-brand":  { "$type": "color", "light": "#FFFFFF", "dark": "#FFFFFF",  "$description": "Text on top of brand/primary color" },
        "hint":      { "$type": "color", "light": "#757575", "dark": "#616161",  "$description": "Placeholder / hint text" }
      },

      "border": {
        "default": { "$type": "color", "light": "#BDBDBD", "dark": "#3D3D3D", "$description": "Default borders and dividers" },
        "strong":  { "$type": "color", "light": "#757575", "dark": "#757575", "$description": "Emphasized borders" },
        "brand":   { "$type": "color", "light": "#1DB954", "dark": "#1DB954", "$description": "Focus rings, selected borders" }
      },

      "state": {
        "error":   { "$type": "color", "light": "#CF6679", "dark": "#EF9A9A" },
        "warning": { "$type": "color", "light": "#FF9800", "dark": "#FFCC80" },
        "success": { "$type": "color", "light": "#1B5E20", "dark": "#A5D6A7" },
        "info":    { "$type": "color", "light": "#0277BD", "dark": "#81D4FA" }
      },

      "accent": {
        "purple": { "$type": "color", "light": "#AB47BC", "dark": "#CE93D8" },
        "amber":  { "$type": "color", "light": "#FFC107", "dark": "#FFD54F" }
      }
    }
  },

  "spacing": {
    "$type": "group",
    "$description": "4dp base scale. All values in logical pixels (dp).",
    "2":   { "$type": "dimension", "$value": "2dp" },
    "4":   { "$type": "dimension", "$value": "4dp" },
    "8":   { "$type": "dimension", "$value": "8dp" },
    "12":  { "$type": "dimension", "$value": "12dp" },
    "16":  { "$type": "dimension", "$value": "16dp" },
    "20":  { "$type": "dimension", "$value": "20dp" },
    "24":  { "$type": "dimension", "$value": "24dp" },
    "32":  { "$type": "dimension", "$value": "32dp" },
    "40":  { "$type": "dimension", "$value": "40dp" },
    "48":  { "$type": "dimension", "$value": "48dp" },
    "56":  { "$type": "dimension", "$value": "56dp" },
    "64":  { "$type": "dimension", "$value": "64dp" },
    "80":  { "$type": "dimension", "$value": "80dp" },
    "96":  { "$type": "dimension", "$value": "96dp" },
    "120": { "$type": "dimension", "$value": "120dp" },
    "padding": {
      "xs":   { "$type": "dimension", "$value": "4dp" },
      "sm":   { "$type": "dimension", "$value": "8dp" },
      "md":   { "$type": "dimension", "$value": "16dp" },
      "lg":   { "$type": "dimension", "$value": "24dp" },
      "xl":   { "$type": "dimension", "$value": "32dp" },
      "page": { "$type": "dimension", "$value": "20dp", "$description": "Horizontal page margin" }
    }
  },

  "radius": {
    "$type": "group",
    "$description": "Border radius scale.",
    "none": { "$type": "dimension", "$value": "0dp" },
    "xs":   { "$type": "dimension", "$value": "4dp",   "$description": "Chips, badges, small tags" },
    "sm":   { "$type": "dimension", "$value": "8dp",   "$description": "Input fields, small cards" },
    "md":   { "$type": "dimension", "$value": "12dp",  "$description": "Standard cards" },
    "lg":   { "$type": "dimension", "$value": "14dp",  "$description": "Large cards, bottom sheets" },
    "xl":   { "$type": "dimension", "$value": "16dp",  "$description": "Dialogs" },
    "xxl":  { "$type": "dimension", "$value": "20dp",  "$description": "Hero cards, featured content" },
    "full": { "$type": "dimension", "$value": "999dp", "$description": "Pills, FAB, circular buttons" }
  },

  "typography": {
    "$type": "group",
    "$description": "Inter (Google Fonts). All sizes in sp (scale-independent pixels).",
    "fontFamily": {
      "base": { "$type": "fontFamily", "$value": "Inter" }
    },
    "scale": {
      "display": {
        "large":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "57sp", "lineHeight": "64px", "letterSpacing": "-0.25%" } },
        "medium": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "45sp", "lineHeight": "52px", "letterSpacing": "0%" } },
        "small":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "36sp", "lineHeight": "44px", "letterSpacing": "0%" } }
      },
      "headline": {
        "large":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 600, "fontSize": "32sp", "lineHeight": "40px", "letterSpacing": "0%" } },
        "medium": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 600, "fontSize": "28sp", "lineHeight": "36px", "letterSpacing": "0%" } },
        "small":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 600, "fontSize": "24sp", "lineHeight": "32px", "letterSpacing": "0%" } }
      },
      "title": {
        "large":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 500, "fontSize": "22sp", "lineHeight": "28px", "letterSpacing": "0%" } },
        "medium": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 500, "fontSize": "16sp", "lineHeight": "24px", "letterSpacing": "0.15%" } },
        "small":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 500, "fontSize": "14sp", "lineHeight": "20px", "letterSpacing": "0.1%" } }
      },
      "body": {
        "large":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "16sp", "lineHeight": "24px", "letterSpacing": "0.5%" } },
        "medium": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "14sp", "lineHeight": "20px", "letterSpacing": "0.25%" } },
        "small":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "12sp", "lineHeight": "16px", "letterSpacing": "0.4%" } }
      },
      "label": {
        "large":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 500, "fontSize": "14sp", "lineHeight": "20px", "letterSpacing": "0.1%" } },
        "medium": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 500, "fontSize": "12sp", "lineHeight": "16px", "letterSpacing": "0.5%" } },
        "small":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 500, "fontSize": "11sp", "lineHeight": "16px", "letterSpacing": "0.5%" } }
      },
      "utility": {
        "button":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 600, "fontSize": "14sp", "lineHeight": "20px", "letterSpacing": "1.25%" } },
        "caption": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "12sp", "lineHeight": "16px", "letterSpacing": "0.4%" } },
        "overline":{ "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 500, "fontSize": "10sp", "lineHeight": "16px", "letterSpacing": "1.5%" } }
      }
    }
  },

  "motion": {
    "$type": "group",
    "$description": "Animation durations and easing curves. Prefer flutter_animate package.",
    "duration": {
      "instant":  { "$type": "duration", "$value": "80ms",  "$description": "Micro-interactions: ripple, checkbox tick" },
      "fast":     { "$type": "duration", "$value": "150ms", "$description": "Tooltips, icon swap" },
      "standard": { "$type": "duration", "$value": "250ms", "$description": "Default transition: modal open, page push" },
      "enter":    { "$type": "duration", "$value": "350ms", "$description": "Elaborate enter animations" },
      "exit":     { "$type": "duration", "$value": "200ms", "$description": "Exit is always faster than enter" },
      "long":     { "$type": "duration", "$value": "500ms", "$description": "Complex sequence / celebration" }
    },
    "easing": {
      "standard":     { "$type": "cubicBezier", "$value": [0.2, 0.0, 0.0, 1.0],  "$description": "Material standard easing — most transitions" },
      "decelerate":   { "$type": "cubicBezier", "$value": [0.0, 0.0, 0.2, 1.0],  "$description": "Elements entering the screen" },
      "accelerate":   { "$type": "cubicBezier", "$value": [0.3, 0.0, 1.0, 1.0],  "$description": "Elements leaving the screen" },
      "spring":       { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1.0], "$description": "Playful spring — success states, FAB" },
      "linear":       { "$type": "cubicBezier", "$value": [0.0, 0.0, 1.0, 1.0],  "$description": "Progress bars, shimmer" }
    },
    "stagger": {
      "list-item": { "$type": "duration", "$value": "40ms",  "$description": "Delay between each list item on enter" },
      "card":      { "$type": "duration", "$value": "60ms",  "$description": "Delay between staggered cards" }
    }
  },

  "shadow": {
    "$type": "group",
    "$description": "Elevation shadows. Dark mode shadows are less visible — rely on bg-surface color.",
    "flat":    { "$type": "shadow", "$value": "none",                                                              "$description": "Level 0 — no elevation" },
    "low":     { "$type": "shadow", "$value": "0px 1px 3px rgba(0,0,0,0.12), 0px 1px 2px rgba(0,0,0,0.24)",      "$description": "Level 1 — cards at rest" },
    "medium":  { "$type": "shadow", "$value": "0px 3px 6px rgba(0,0,0,0.15), 0px 2px 4px rgba(0,0,0,0.12)",      "$description": "Level 2 — FAB, bottom nav" },
    "high":    { "$type": "shadow", "$value": "0px 10px 20px rgba(0,0,0,0.15), 0px 3px 6px rgba(0,0,0,0.10)",    "$description": "Level 3 — modals, drawers" },
    "overlay": { "$type": "shadow", "$value": "0px 19px 38px rgba(0,0,0,0.30), 0px 15px 12px rgba(0,0,0,0.22)",  "$description": "Level 4 — full-screen overlays" }
  },

  "grid": {
    "$type": "group",
    "$description": "Responsive grid system for Flutter LayoutBuilder breakpoints.",
    "mobile": {
      "columns":     { "$type": "number", "$value": 4 },
      "gutter":      { "$type": "dimension", "$value": "16dp" },
      "margin":      { "$type": "dimension", "$value": "20dp" },
      "breakpoint":  { "$type": "dimension", "$value": "0dp" }
    },
    "tablet": {
      "columns":     { "$type": "number", "$value": 8 },
      "gutter":      { "$type": "dimension", "$value": "24dp" },
      "margin":      { "$type": "dimension", "$value": "32dp" },
      "breakpoint":  { "$type": "dimension", "$value": "600dp" }
    },
    "desktop": {
      "columns":     { "$type": "number", "$value": 12 },
      "gutter":      { "$type": "dimension", "$value": "32dp" },
      "margin":      { "$type": "dimension", "$value": "64dp" },
      "breakpoint":  { "$type": "dimension", "$value": "900dp" }
    }
  }
}
